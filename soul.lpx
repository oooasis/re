#!name = Soul
#!author = 树先生, 怎么肥事, 奶思
#!desc = 移除广告
#!icon = https://github.com/ishowshu/loon/raw/refs/heads/main/icon/soul.png
#!date = 2026-09-19

# 实际部署: https://raw.githubusercontent.com/oooasis/re/refs/heads/main/soul.lpx
# 上游: https://github.com/ishowshu/loon/blob/main/plugin/soul-new.lpx
# 修正: 复写去掉 QX 的 url 关键字；规则改为 DOMAIN/IP-CIDR + REJECT/DIRECT；[Mitm]；
#       jq 字段缺失时不报错；两条脚本统一用 soul.js（soul_qx.js 含 QX 专有 $notify）
#       MitM 只保留规则实际用到的主机（原 29 个含 19 个裸 IP，疑似导致 Soul 断网）

[Rule]
# 分流走直连，避免影响功能使用
IP-CIDR,13.127.149.196/32,DIRECT
IP-CIDR,52.194.158.59/32,DIRECT
IP-CIDR,47.56.131.76/32,DIRECT
IP-CIDR,47.75.72.47/32,DIRECT
IP-CIDR,3.0.163.78/32,DIRECT

# 官方广告
DOMAIN,ssp.soulapp.cn,REJECT
DOMAIN,soul-ad.soulapp.cn,REJECT
DOMAIN,ad-r.soulapp.cn,REJECT

# 第三方平台广告
DOMAIN,ssp.1rtb.com,REJECT
DOMAIN,impdsp.meituan.com,REJECT
#DOMAIN,s3plus.meituan.net,REJECT
DOMAIN,ssp.maplehaze.cn,REJECT

[Rewrite]
# 广告下发
^https:\/\/ssp\.soulapp\.cn\/api\/q reject-dict
^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain reject-dict
# 我的页面瞬间指导
^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card reject-dict
# 青少年弹窗
^https:\/\/api-account\.soulapp\.cn\/teenager\/config reject-dict
# 谁看过我横幅广告
^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module reject-dict
# 我的页面右下角悬浮广告
^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content reject-dict
# 通讯录右下角机器人图标
^https:\/\/api-chat\.soulapp\.cn\/addressBook\/showBubblingEnter reject
# 表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/interact\/getEmojiList reject
# 我的页面soul币活动推荐
^https:\/\/increase-openapi\.soulapp\.cn\/increase\/fission\/getHomePageRedIcon reject
# 首次私聊打开星球交汇小卡片
^https:\/\/api-chat\.soulapp\.cn\/similar\/post\/intersect\/trigger reject
# 首次打开私聊界面底部瞬间表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord reject
# 聊天输入文字时的gif表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/emoji\/recommend reject
# 私聊瞬间小横幅
^https:\/\/api-a\.soulapp\.cn\/shara\/app\/url reject
# 私聊快捷菜单
^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu reject
# 私聊用户匹配推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/session\/quickButtonCheck reject-dict
# 派对体验反馈
^https:\/\/chat-live\.soulapp\.cn\/live\/config\/rec-feedback reject-dict
# 广场关注tab用户派对推荐
^https:\/\/post\.soulapp\.cn\/post\/relationUser\/chatRooms reject-dict
# 聊天页通讯录tab邀请好友回归横幅
^https:\/\/increase-openapi\.soulapp\.cn\/increase\/dusting\/getAddressBookDustings reject-dict
# 派对的关注tab隐藏猜我喜欢的派对
^https:\/\/chat-live\.soulapp\.cn\/live\/queryRelevantList reject-dict
# 主页ai描述推荐
^https:\/\/api-user\.soulapp\.cn\/user\/desc\/getUserPersonalDesc reject-dict
# 我的页面瞬间得分向导
^https:\/\/post\.soulapp\.cn\/v1\/post\/homepage\/ai\/assistant\/guide reject-dict
# 聊天列表页面顶部头像推荐横幅
^https:\/\/api-chat\.soulapp\.cn\/chatList\/limitAvatar\/entrance reject-dict
# 聊天列表页面顶部用户推荐
^https:\/\/api-chat\.soulapp\.cn\/chatList\/top\/recommendList reject-dict
# 派对左、右上角广告图标
^https:\/\/activity\.soulapp\.cn\/commercial\/room\/resources reject-dict
^https:\/\/chat-live\.soulapp\.cn\/official\/scene\/module reject-dict
# 星球页面派对的游戏栏
^https:\/\/chat-live\.soulapp\.cn\/live\/planet\/match\/game\/configList reject-dict
# 派对的创建按钮广告提示
^https:\/\/chat-live\.soulapp\.cn\/square\/getSkinConfig reject-dict

# 派对页面的关注tab中我的关注推荐
^https:\/\/chat-live\.soulapp\.cn\/live\/queryFollowRoomList response-body-json-jq '.data.recUserFeedList = []'
# 派对页面的关注tab中猜你喜欢
^https:\/\/chat-live\.soulapp\.cn\/square\/relation\/guideUserList response-body-json-jq '.data.userDTOList = []'
# 星球页面
^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config response-body-json-jq '.data.showRedMind = false | .data.showLuckyBag = false | .data.coreCards |= if . then map(select(.type != 27)) else . end'
# 派对列表中间横幅官方广告
^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList response-body-json-jq '.data.positionContentRespList = []'
# 我的页面tab
^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2 response-body-json-jq '.data.selectedTagPool = {} | .data.headTabDTOList |= if . then map(select(.tabCode != "STAR_TRAILS")) else . end'
# 派对频道列表
^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo response-body-json-jq '.data.res |= if . then map(.iconConfig = null) else . end'

[Script]
# 私聊限制
http-response ^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo script-path=https://raw.githubusercontent.com/ishowshu/qx/refs/heads/main/script/soul.js, requires-body=true, tag=解锁私聊
# 私聊阅后即焚
http-response ^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url script-path=https://raw.githubusercontent.com/ishowshu/qx/refs/heads/main/script/soul.js, requires-body=true, tag=私聊阅后即焚

[Mitm]
hostname = ssp.soulapp.cn, increase-openapi.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, api-user.soulapp.cn, chat-live.soulapp.cn, api-chat.soulapp.cn, activity.soulapp.cn, 47.110.187.87
