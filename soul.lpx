#!name = Soul 阅后即焚
#!desc = 私聊阅后即焚照片推送通知，可预览、点开看原图
#!author = 树先生
#!icon = https://github.com/ishowshu/loon/raw/refs/heads/main/icon/soul.png
#!loon_version = 3.5.1(983)

# 实际部署: https://raw.githubusercontent.com/oooasis/re/refs/heads/main/soul.lpx
# 上游: https://github.com/ishowshu/loon/blob/main/plugin/soul-new.lpx（只保留阅后即焚，去广告规则全部移除）

[Script]
response if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/oooasis/re/refs/heads/main/soul.snapchat.js") with tag="阅后即焚", timeout=10, requires_body=true

[Mitm]
hostname = api-chat.soulapp.cn
