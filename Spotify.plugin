#!name = Spotify
#!desc = 部分解锁 Premium、去播放广告、歌手/专辑列表正常展示、去随机播放。登录后再启用，重启 App 等待生效；音质不能设为超高
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,会员解锁

[Rewrite]
# 删 If-None-Match，避免 304 无 Body 导致脚本不生效
request if ${url} ~= /^https:\/\/(?:[^\/]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/user-customization-service\/v1\/customize$/ then request.header.del("If-None-Match")
# 歌手/专辑页按 iPad 布局请求
request if ${url} ~= /^(https:\/\/(?:[^\/]+-)?spclient(?:\.wg)?\.spotify\.com)(?::443)?(\/(?:artistview\/v1\/artist|album-entity-view\/v2\/album)\/.*platform=)iphone/ as m then url.replace("${m.1}${m.2}ipad")

[Script]
response if ${url} ~= /^https:\/\/(?:[^\/]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/oooasis/re/refs/heads/main/Spotify.proto.js") with tag="Spotify", timeout=10, requires_body=true, binary_body_mode=true

[Mitm]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
