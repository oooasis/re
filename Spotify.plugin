#!name = Spotify
#!desc = 去广告 + 解锁部分会员功能（由 spotfiy.conf 转写）
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,会员解锁

[Argument]
tab = switch,false,tag=隐藏底栏 Create 页,desc=改写 ios-feature-navigation/tab_configuration
useractivity = switch,true,tag=保留收听动态分享,desc=关闭后 is_useractivity_sharing_enabled=false

[Rewrite]
# 艺人页按 iPad 布局请求：直接改写 URL，省掉 302 的一次往返
request if ${url} ~= /^(https?:\/\/(?:gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com\/artistview\/v1\/artist\/.*&platform=)iphone/ as m then url.replace("${m.1}ipad")
# 广告接口：本地返回 200 空 Body，请求不再发往上游
request if ${url} ~= /^https?:\/\/(?:gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com\/(?:ad-|pendragon)/ then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/(?:gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com\/(?:bootstrap|user-customization-service)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/oooasis/re/refs/heads/main/Spotify.Crack.Dev.modified.js", {${tab}, ${useractivity}}) with tag="Spotify", timeout=10, requires_body=true, binary_body_mode=true

[Mitm]
hostname = gae2-spclient.spotify.com, guc3-spclient.spotify.com, spclient.wg.spotify.com
